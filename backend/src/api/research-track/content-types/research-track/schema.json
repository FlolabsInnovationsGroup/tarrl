{
  "kind": "collectionType",
  "collectionName": "research_tracks",
  "info": {
    "singularName": "research-track",
    "pluralName": "research-tracks",
    "displayName": "Research Track",
    "description": "Research areas and focus tracks for TARRL"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "icon": {
      "type": "string"
    },
    "shortDescription": {
      "type": "text",
      "required": true
    },
    "fullDescription": {
      "type": "richtext"
    },
    "examples": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "coming-soon", "research"],
      "default": "active"
    }
  }
}
